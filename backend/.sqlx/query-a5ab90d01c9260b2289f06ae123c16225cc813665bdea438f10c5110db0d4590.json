  "query": "\n        SELECT r.uri, r.cid, r.did, r.status, r.indexed_at\n        FROM rsvps r\n        WHERE r.subject_uri = $1 AND ($2::text IS NULL OR r.status = $2)\n        ORDER BY r.indexed_at DESC\n        LIMIT $3 OFFSET $4\n        ",
