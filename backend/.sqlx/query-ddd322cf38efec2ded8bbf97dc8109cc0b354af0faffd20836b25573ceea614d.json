{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.uri, r.cid, r.did, r.subject_uri, r.subject_cid, r.status, r.indexed_at,\n               e.name as event_name, e.starts_at as event_starts_at\n        FROM rsvps r\n        JOIN events e ON r.subject_uri = e.uri\n        WHERE r.did = $1\n        ORDER BY r.indexed_at DESC\n        LIMIT $2 OFFSET $3\n        ",
