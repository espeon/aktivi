  "query": "\n        SELECT p.did, p.display_name, p.description, p.avatar, p.banner, p.indexed_at, i.handle\n        FROM profiles p\n        LEFT JOIN identities i ON p.did = i.did\n        WHERE p.did = $1\n        ",
