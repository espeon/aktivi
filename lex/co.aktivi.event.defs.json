{
  "lexicon": 1,
  "id": "co.aktivi.event.defs",
  "defs": {
    "eventViewBasic": {
      "type": "object",
      "required": ["uri", "cid", "name"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "name": {
          "type": "string"
        },
        "startsAt": {
          "type": "string",
          "format": "datetime"
        },
        "avatarURL": {
          "type": "string",
          "description": "CDN URL for the avatar image for the event."
        },
        "tags": {
          "type": "array",
          "description": "Custom tags or categories for the event.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "eventView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "indexedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "author": {
          "type": "ref",
          "ref": "co.aktivi.actor.defs#profileViewBasic"
        },
        "record": {
          "type": "unknown"
        },
        "style": {
          "type": "ref",
          "ref": "co.aktivi.calendar.eventEnrichmentData#eventStyle",
          "description": "Visual design style for the event."
        },
        "avatarURL": {
          "type": "string",
          "description": "CDN URL for the avatar image for the event."
        },
        "tags": {
          "type": "array",
          "description": "Custom tags or categories for the event.",
          "items": {
            "type": "string"
          }
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "eventViewDetailed": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "indexedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "author": {
          "type": "ref",
          "ref": "co.aktivi.actor.defs#profileView"
        },
        "record": {
          "type": "unknown"
        },
        "goingCount": {
          "type": "integer",
          "description": "Count of RSVPs with 'going' status"
        },
        "interestedCount": {
          "type": "integer",
          "description": "Count of RSVPs with 'interested' status"
        },
        "selectedRsvps": {
          "type": "array",
          "description": "Sample of RSVPs to display (up to 3)",
          "items": {
            "type": "ref",
            "ref": "co.aktivi.actor.defs#profileViewBasic"
          }
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "currentUserStatus": {
          "type": "string",
          "description": "The RSVP status of the requesting user for this event",
          "knownValues": [
            "community.lexicon.calendar.rsvp#interested",
            "community.lexicon.calendar.rsvp#going",
            "community.lexicon.calendar.rsvp#notgoing"
          ]
        },
        "currentUserRsvpUri": {
          "type": "string",
          "format": "at-uri",
          "description": "The AT-URI of the requesting user's RSVP record for this event"
        }
      }
    },
    "eventsByDate": {
      "type": "object",
      "required": ["date", "events"],
      "properties": {
        "date": {
          "type": "string",
          "format": "datetime",
          "description": "ISO 8601 date string (YYYY-MM-DD)"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "co.aktivi.event.defs#eventView"
          }
        }
      }
    }
  }
}
